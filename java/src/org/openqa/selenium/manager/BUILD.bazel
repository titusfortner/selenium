load("//common:defs.bzl", "copy_file")
load("//common/manager:defs.bzl", "SELENIUM_MANAGER_PLATFORMS", "selenium_manager_binary", "selenium_manager_filename")
load("//java:defs.bzl", "java_export")
load("//java:version.bzl", "SE_VERSION")

java_export(
    name = "manager",
    srcs = glob(["*.java"]),
    maven_coordinates = "org.seleniumhq.selenium:selenium-manager:%s" % SE_VERSION,
    opens_to = [
        "org.seleniumhq.selenium.json",
    ],
    pom_template = "//java/src/org/openqa/selenium:template-pom",
    resources = [
        ":manager-notice",
        ":manager-sbom",
    ] + [":manager-%s" % platform for platform in SELENIUM_MANAGER_PLATFORMS],
    tags = [
        "release-artifact",
    ],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//java/src/org/openqa/selenium:core",
        "//java/src/org/openqa/selenium/json",
        "//java/src/org/openqa/selenium/os",
        "@maven//:org_jspecify_jspecify",
    ],
)

[
    copy_file(
        name = "manager-%s" % platform,
        src = selenium_manager_binary(platform),
        out = "%s/%s" % (
            platform,
            selenium_manager_filename(platform),
        ),
    )
    for platform in SELENIUM_MANAGER_PLATFORMS
]

copy_file(
    name = "manager-sbom",
    src = "//common/manager:selenium-manager-sbom",
    out = "selenium-manager.cdx.json",
)

copy_file(
    name = "manager-notice",
    src = "//common/manager:selenium-manager-notice",
    out = "selenium-manager-THIRD-PARTY-NOTICES.txt",
)
