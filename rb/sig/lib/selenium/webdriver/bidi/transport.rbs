module Selenium
  module WebDriver
    class BiDi
      # Low-level command seam for the generated Protocol layer.
      class Transport
        @connection: untyped

        def self.for: (untyped context) -> Transport

        def initialize: (untyped connection) -> void

        def execute: (cmd: String, ?params: untyped, ?result: untyped) -> untyped

        private

        def serialize: (untyped params) -> untyped

        def error_message: (Hash[String, untyped] reply) -> String
      end
    end
  end
end
