module Selenium
  module WebDriver
    module Remote
      class BiDiBridge < Bridge
        @browsing_context: BiDi::Protocol::BrowsingContext

        @transport: BiDi::Transport

        @bidi: BiDi

        READINESS_STATE: Hash[String, String]

        attr_reader bidi: BiDi

        attr_reader transport: BiDi::Transport

        def create_session: (untyped capabilities) -> void

        def get: (String url) -> void

        def go_back: () -> void

        def go_forward: () -> void

        def refresh: () -> void

        def quit: () -> void

        def close: () -> untyped

        private

        def browsing_context: () -> BiDi::Protocol::BrowsingContext

        def readiness: () -> String?
      end
    end
  end
end
