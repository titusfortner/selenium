package(
    default_visibility = [
        "//dotnet/src/webdriver:__pkg__",
        "//dotnet/test/common:__pkg__",
        "//java/src/org/openqa/selenium/manager:__pkg__",
        "//javascript/selenium-webdriver:__pkg__",
        "//py:__pkg__",
        "//rb:__pkg__",
    ],
)

# The published macOS artifact is universal and the published Windows artifact
# is 32-bit, so one prebuilt covers both architectures of those platforms.
SELENIUM_MANAGER_PLATFORMS = {
    "linux-arm64": "@download_sm_linux_arm64//file",
    "linux-x86_64": "@download_sm_linux_x86_64//file",
    "macos-arm64": "@download_sm_macos//file",
    "macos-x86_64": "@download_sm_macos//file",
    "windows-arm64": "@download_sm_windows//file",
    "windows-x86_64": "@download_sm_windows//file",
}

[
    alias(
        name = "selenium-manager-%s" % platform,
        actual = select({
            "//common:use_pinned_browser": published,
            "//conditions:default": "//rust:selenium-manager-%s" % platform,
        }),
    )
    for (platform, published) in SELENIUM_MANAGER_PLATFORMS.items()
]

alias(
    name = "selenium-manager-sbom",
    actual = "@download_sm_sbom//file",
)

alias(
    name = "selenium-manager-notice",
    actual = "@download_sm_notice//file",
)
